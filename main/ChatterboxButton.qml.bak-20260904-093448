import QtQuick
import Quickshell
import Quickshell.Io

Rectangle {
    id: chatterboxButton

    property var barWindow
    property bool serverRunning: false

    visible: serverRunning

    width: 30
    height: 28
    radius: 5
    color: chatterboxMouse.containsMouse
        ? (serverRunning ? "#304f38" : "#454545")
        : "transparent"

    Process {
        id: statusProcess
        command: ["sh", "-c", "ss -ltn '( sport = :8004 )' | grep -q LISTEN"]
        running: false
        onExited: function(exitCode, exitStatus) {
            chatterboxButton.serverRunning = exitCode === 0
        }
    }

    Timer {
        // Chatterbox state changes are infrequent; avoid needless idle wakeups.
        interval: 10000
        running: true
        repeat: true
        onTriggered: if (!statusProcess.running) statusProcess.running = true
    }

    Component.onCompleted: statusProcess.running = true

    Text {
        anchors.centerIn: parent
        text: "󰍬"
        color: serverRunning ? "#9be9a8" : "#858585"
        font.family: "Symbols Nerd Font"
        font.pixelSize: 17
    }

    MouseArea {
        id: chatterboxMouse
        anchors.fill: parent
        hoverEnabled: true
        onClicked: barWindow.chatterboxMenu.visible = !barWindow.chatterboxMenu.visible
        cursorShape: Qt.PointingHandCursor
    }
}
