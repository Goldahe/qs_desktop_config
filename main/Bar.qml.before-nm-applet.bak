import QtQuick
import Quickshell
import Quickshell.Hyprland
import Quickshell.Services.Pipewire
import Quickshell.Networking
import Quickshell.Bluetooth

PanelWindow {
    id: bar

    anchors {
        bottom: true
        left: true
        right: true
    }

    property int taskbarHeight: 38

    implicitHeight: taskbarHeight
    color: "#e6171717"
    exclusiveZone: implicitHeight

    SystemClock {
        id: clock
        precision: SystemClock.Minutes
    }

    property var wifiDevice: {
        for (const device of Networking.devices.values) {
            if (device.type === DeviceType.Wifi)
                return device
        }
        return null
    }

    property var connectedBluetooth: {
        for (const device of Bluetooth.devices.values) {
            if (device.connected)
                return device
        }
        return null
    }

    // Explicit component interfaces for popup controls.
    property var powerMenu: powerPopup
    property var wifiMenu: wifiPopup
    property var calendarMenu: calendarPopup
    property var hardwareMenu: hardwarePopup

    function wifiText() {
        if (!wifiDevice)
            return "󰤭"
        if (!wifiDevice.connected)
            return "󰤭"
        return "󰤨"
    }

    function bluetoothText() {
        if (!Bluetooth.defaultAdapter || !Bluetooth.defaultAdapter.enabled)
            return "󰂲"
        if (connectedBluetooth)
            return "󰂱  " + (connectedBluetooth.name || connectedBluetooth.deviceName)
        return "󰂯"
    }

    function powerAction(command) {
        Quickshell.execDetached(["sh", "-c", command])
        powerPopup.visible = false
    }

    function openWifiMenu() {
        powerPopup.visible = false
        wifiPopup.visible = !wifiPopup.visible
    }

    function openCalendar() {
        calendarPopup.year = clock.date.getFullYear()
        calendarPopup.month = clock.date.getMonth()
        wifiPopup.visible = false
        powerPopup.visible = false
        calendarPopup.visible = !calendarPopup.visible
    }

    function connectWifi(network) {
        if (network.known || network.security === WifiSecurityType.Open)
            network.connect()
        else
            Quickshell.execDetached(["nm-connection-editor"])
        wifiPopup.visible = false
    }

    Workspaces {}
    HardwareButton {
        barWindow: bar
    }
    StatusControls {
        barWindow: bar
        clock: clock
    }
    PowerPopup {
        id: powerPopup
        barWindow: bar
    }
    WifiPopup {
        id: wifiPopup
        barWindow: bar
    }
    CalendarPopup {
        id: calendarPopup
        barWindow: bar
        clock: clock
    }
    HardwarePopup {
        id: hardwarePopup
        barWindow: bar
    }
}
