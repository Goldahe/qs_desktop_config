float sampleSpectrum(int index) {
    if (index == 0) return ubuf.s0;
    if (index == 1) return ubuf.s1;
    if (index == 2) return ubuf.s2;
    if (index == 3) return ubuf.s3;
    if (index == 4) return ubuf.s4;
    if (index == 5) return ubuf.s5;
    if (index == 6) return ubuf.s6;
    if (index == 7) return ubuf.s7;
