vec3 hsv2rgb(vec3 c) {
    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
    return c.z * mix(vec3(1.0), rgb, c.y);
}
void main() {
    vec2 uv = qt_TexCoord0;
    float pixelX = floor(uv.x * ubuf.screenWidth);
    float barPixel = 1.0 - step(1.0, mod(pixelX, 2.0));
    float mirroredX = uv.x < 0.5 ? uv.x * 2.0 : (1.0 - uv.x) * 2.0;
    int bin = min(43, int(floor(mirroredX * ubuf.binCount)));
    float strength = clamp(sampleSpectrum(bin), 0.0, 1.0);
    float barTop = 1.0 - strength * 0.5;
    float body = step(barTop, uv.y) * barPixel;
    float cap = (1.0 - smoothstep(barTop - 0.002, barTop + 0.002, uv.y)) * barPixel;
    vec3 color = hsv2rgb(vec3(uv.x, 0.88, 1.0));
    float alpha = clamp(body * 0.72 + cap * 0.98, 0.0, 1.0);
    fragColor = vec4(color * alpha, alpha) * ubuf.qt_Opacity;
}
